{
  "name": "ev-motor-erp-backend",
  "version": "1.0.0",
  "description": "Node.js API backend for the EV Motor Manufacturing ERP.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "generate:pr-items": "node scripts/generatePurchaseRequisitionItemsSeed.js",
    "generate:purchase-orders": "node scripts/generatePurchaseOrdersSeed.js",
    "generate:purchase-order-items": "node scripts/generatePurchaseOrderItemsSeed.js",
    "generate:goods-receipts": "node scripts/generateGoodsReceiptsSeed.js",
    "generate:goods-receipt-items": "node scripts/generateGoodsReceiptItemsSeed.js",
    "generate:inventory-transactions": "node scripts/generateInventoryTransactionsSeed.js",
    "generate:production-orders": "node scripts/generateProductionOrdersSeed.js",
    "generate:production-order-items": "node scripts/generateProductionOrderItemsSeed.js",
    "import:bom-master": "node scripts/importBomMasterFromExcel.js",
    "generate:bom-consumption": "node scripts/generateBomConsumptionSeed.js",
    "generate:finished-goods-receipts": "node scripts/generateFinishedGoodsReceiptSeed.js",
    "generate:move-orders": "node scripts/generateMoveOrdersSeed.js",
    "seed:user-accounts": "node scripts/seedUserAccounts.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.5"
  }
}
